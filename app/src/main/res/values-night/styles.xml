<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BackgroundMainActivity">
        <item name="android:background">@color/grey_100</item>
    </style>

    <style name="SwitchSetting">
        <item name="android:thumbTint">@color/blue_100</item>
        <item name="android:trackTint">@color/blue_500</item>
    </style>

    <style name="SwitchSettingMaterial">
        <item name="thumbTint">@color/blue_100</item>
        <item name="trackTint">@color/blue_500</item>
        <item name="android:checked">true</item>
    </style>

    <style name="TextViewSetting">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_regular</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
    </style>

    <style name="TextViewSettingHeader">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="EditTextSearch">
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/grey_100</item>
    </style>

    <style name="ImageButtonSettingHeader">
        <item name="tint">@color/white</item>
    </style>

    <style name="ImageViewColor">
        <item name="tint">@color/white</item>
    </style>

    <style name="TextViewH1Color">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_regular</item>
    </style>

    <style name="TextViewH2Color">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_regular</item>
    </style>

    <style name="TextViewHeaderSearchColor">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_large</item>
    </style>

    <style name="ImageViewSetting">
        <item name="tint">@color/white</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="TextPlaceHolder">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="ButtonPlaceHolder">
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textColor">@color/grey_100</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="ButtonClearSearchHistory">
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textColor">@color/grey_100</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="TextViewYSMediumOneTheme">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_small</item>
    </style>

    <style name="TextViewYSMediumTwoTheme">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_small_2</item>
    </style>

    <style name="TextViewYSMediumThreeTheme">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_small_3</item>
    </style>

    <style name="TextViewYSMediumTimeTrack">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_small_4</item>
    </style>

</resources>