<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Не дает содержимому экрана уходить под статус бар -->
        <item name="android:windowTranslucentStatus">false</item>

        <!-- Цвета фона -->
        <item name="colorPrimary">@color/white</item>

        <!-- Цвета текста на фоне -->
        <item name="colorOnPrimary">@color/yp_black</item>
        <item name="colorOnPrimaryFixed">@color/grey</item>

        <!-- Цвет фона поля ввода текста -->
        <item name="colorOnPrimaryContainer">@color/light_grey</item>

        <!-- Цвет текста поля ввода -->
        <item name="colorOnPrimaryFixedVariant">@color/grey</item>

        <!--  Вариант цвета фона -->
        <item name="colorSecondary">@color/blue</item>

        <!-- Цвет текста на варианте фона -->
        <item name="colorOnSecondary">@color/white</item>

        <!-- Цвет кнопок главного меню -->
        <item name="colorTertiary">@color/white</item>

        <!-- Цвет текста на фоне кнопок главного меню -->
        <item name="colorOnTertiary">@color/yp_black</item>

        <item name="hintSelectorColor">@color/hint_selector_light</item>
    </style>

    <style name="Theme.PlaylistMaker" parent="Base.Theme.PlaylistMaker" />

    <style name="CustomDialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <!-- Белый фон окна -->
        <item name="android:windowBackground">@color/white</item>
        <item name="android:background">@color/white</item>

        <!-- Цвет текста заголовка и сообщения -->
        <item name="android:textColorPrimary">@color/yp_black</item>

        <!-- Цвет кнопок (Синий) -->
        <item name="colorPrimary">@color/blue</item>
        <item name="colorAccent">@color/blue</item>

        <!-- Стиль текста кнопок -->
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonStyle</item>
    </style>

    <style name="DialogButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/blue</item>
        <item name="android:textAllCaps">true</item>
    </style>

</resources>